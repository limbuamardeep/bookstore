[
  {
    "id": "dropColumn.Book.name",
    "label": "Drop column \"name\" from \"Book\"",
    "operationClass": "destructive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "name",
        "table": "Book"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"name\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "Book",
          "name"
        ]
      }
    ],
    "execute": [
      {
        "description": "drop column \"name\"",
        "sql": "ALTER TABLE \"public\".\"Book\" DROP COLUMN \"name\""
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"name\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "Book",
          "name"
        ]
      }
    ]
  }
]